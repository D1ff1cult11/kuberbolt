# ============================================================
# Kuberbolt Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit real keys or secrets.
# ============================================================

# --------------- SDK Server (Machine C — Linux) ---------------
FRONTEND_ORIGIN=*
DEFAULT_RELAYS=wss://relay.damus.io,wss://nos.lol

# Redis — required for agent session registry
REDIS_URL=redis://localhost:6379/0

# Fernet key — encrypts private keys at rest in Redis
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AGENT_FERNET_KEY=

# --------------- Nostr Config (all machines) ------------------
KUBERBOLT_RELAYS=wss://relay.damus.io,wss://nos.lol
KUBERBOLT_HANDSHAKE_TIMEOUT_SECONDS=30

# Agent keys — filled after registration via /api/agents/register
KUBERBOLT_CLIENT_NSEC=
KUBERBOLT_PROVIDER_NSEC=
KUBERBOLT_PROVIDER_PUBKEY=
KUBERBOLT_CLIENT_IDENTITY_PATH=examples/client_identity.json
KUBERBOLT_PROVIDER_IDENTITY_PATH=examples/provider_identity.json
KUBERBOLT_PROVIDER_HOST=127.0.0.1
KUBERBOLT_PROVIDER_PORT=54654

# --------------- Seller Brain (Machine B — macOS) -------------
SELLER_NOSTR_PRIVKEY=
BRAIN_HOST=0.0.0.0
BRAIN_PORT=8001
FP_GRPC_PORT=6001

# --------------- Buyer Agent (Machine A — Windows) ------------
SDK_SERVER_URL=http://<MACHINE_C_IP>:8000
BUYER_NOSTR_PUBKEY=
BUYER_SESSION_TOKEN=
BUYER_FP_ADDR=127.0.0.1:6001

# --------------- Shared / Optional ----------------------------
GOOGLE_API_KEY=
