# Kuberbolt environment. Copy to .env (never commit it); the start scripts source it.
# Everything else lives in $KUBERBOLT_HOME/$KUBERBOLT_AGENT/config.yaml
# (create it with: kuberbolt init --name <agent> --role <client|merchant>).

# Optional. Base directory for agent dirs; defaults to ~/.kuberbolt.
KUBERBOLT_HOME=

# Required. Name of this machine's agent (the directory under KUBERBOLT_HOME).
KUBERBOLT_AGENT=

# Optional. Comma-separated relay URLs that override network.nostr_relays in config.yaml.
KUBERBOLT_RELAYS=

# Required by the brains (Gemini).
GOOGLE_API_KEY=
